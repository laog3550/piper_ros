<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- 仅供只读 CAN 进程使用，保留当前 UDP 传输，避免共享内存端口故障。 -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>piper_can_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="piper_can_participant" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>piper_can_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
  <!-- 网络发送移到 DDS 线程；历史缓存满时立即失败，由节点报告并停录。 -->
  <publisher profile_name="piper_can_writer" is_default_profile="true">
    <qos>
      <publishMode><kind>ASYNCHRONOUS</kind></publishMode>
      <reliability>
        <kind>RELIABLE</kind>
        <max_blocking_time><sec>0</sec><nanosec>0</nanosec></max_blocking_time>
      </reliability>
      <data_sharing><kind>OFF</kind></data_sharing>
    </qos>
    <topic>
      <resourceLimitsQos>
        <max_samples>100000</max_samples>
        <max_instances>1</max_instances>
        <max_samples_per_instance>100000</max_samples_per_instance>
        <allocated_samples>1000</allocated_samples>
      </resourceLimitsQos>
    </topic>
    <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
  </publisher>
  <subscriber profile_name="piper_can_reader" is_default_profile="true">
    <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
    <qos><data_sharing><kind>OFF</kind></data_sharing></qos>
  </subscriber>
</profiles>
